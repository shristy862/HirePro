{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    "isolatedModules": true,

    "moduleResolution": "node",

    "types": ["node"]
  },

  "include": ["src"],
  "exclude": ["node_modules"]
}