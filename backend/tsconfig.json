{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "moduleResolution": "node",

    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "types": ["node"],

    "ignoreDeprecations": "5.0"
  },

  "include": ["src"],
  "exclude": ["node_modules"]
}